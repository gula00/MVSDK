CamTools QLabel#lbIconIndex {
	image: url("Skins/Default/CamTools/Parts_Btn_Dialog_Help_Hover.png");
}
CamTools QLabel#lbIconIndex:hover {
	image: url("Skins/Default/CamTools/Parts_Btn_Dialog_Help_Hover.png");
}
CamTools QLabel#lbIconIndex:pressed {
	image: url("Skins/Default/CamTools/Parts_Btn_Dialog_Help_Pressed.png");
}
CamTools QLabel#lbIconIndex:disabled {
	image: url("Skins/Default/CamTools/Parts_Btn_Dialog_Help_Disable.png");
}
