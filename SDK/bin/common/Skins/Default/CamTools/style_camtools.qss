/*CamTools styleSheet*/

CamTools {
	background-color: rgb(90, 90, 90);
}

CamTools QRadioButton {
	color:rgb(180,180,180);
}
CamTools QRadioButton:hover {
	color:rgb(236,137,9);
}
CamTools QRadioButton:checked {
	color:rgb(236,137,9);
}

CamTools QRadioButton#UPGRADE::indicator::unchecked {
    image: url(Skins/Default/CamTools/Parts_UpgradeBtn_UnChecked_Normal.png);
}
CamTools QRadioButton#UPGRADE::indicator::unchecked:hover {
    image: url(Skins/Default/CamTools/Parts_UpgradeBtn_UnChecked_Hover.png);
}
CamTools QRadioButton#UPGRADE::indicator::unchecked:pressed {
    image: url(Skins/Default/CamTools/Parts_UpgradeBtn_UnChecked_Pressed.png);
}
CamTools QRadioButton#UPGRADE::indicator::unchecked:disabled {
    image: url(Skins/Default/CamTools/Parts_UpgradeBtn_UnChecked_Disable.png);
}
CamTools QRadioButton#UPGRADE::indicator::checked {
    image: url(Skins/Default/CamTools/Parts_UpgradeBtn_UnChecked_Pressed.png);
}
