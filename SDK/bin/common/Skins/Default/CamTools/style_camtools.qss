QUpgradeWidget QTableWidget {
	color:#FFFFFF;
	background: #606060;
	selection-color: rgb(255,255,255);
	alternate-background-color: rgb(120,120,120);
	selection-background-color: rgb(120,120,120);	
}

QUpgradeWidget QLabel#QTips{
	 font-size: 12px;
	 font-weight:300;
	 color:#E69B55;
}

QAuthorizationWidget QTreeWidget{	
	border-top: 2px solid transparent;
	padding-top: 1px;
	background: #606060;
	color:#FFFFFF;
}
QAuthorizationWidget QTreeWidget::item {
	height: 25;
}
QAuthorizationWidget QTreeWidget::item:hover {
	background: #505050;
}

CFpnViewDlg QWidget#widget {
    image: url(Skins/Default/Parts_Icon_Vendor_Logo-2.png); 
    background-color: rgb(0, 0, 0);
}
CamTools QWidget#rightWidget{
	background: #404040;
}

CommonTitleBar QToolButton#btnMax[maxNormal="true"]  {
	border-image: url("Skins/Default/CamTools/Parts_Btn_Window_Reduction_Normal.png");
}
CommonTitleBar QToolButton#btnMax[maxNormal="true"] :hover {
	border-image: url("Skins/Default/CamTools/Parts_Btn_Window_Reduction_Hover.png");
}
CommonTitleBar QToolButton#btnMax[maxNormal="true"] :pressed {
	border-image: url("Skins/Default/CamTools/Parts_Btn_Window_Reduction_Pressed.png");
}


CommonTitleBar QToolButton#btnMax[maxNormal="false"] {
	border-image: url("Skins/Default/CamTools/Parts_Btn_Window_Maximum_Normal.png");
}
CommonTitleBar QToolButton#btnMax[maxNormal="false"] :hover {
	border-image: url("Skins/Default/CamTools/Parts_Btn_Window_Maximum_Hover.png");
}
CommonTitleBar QToolButton#btnMax[maxNormal="false"] :pressed {
	border-image: url("Skins/Default/CamTools/Parts_Btn_Window_Maximum_Pressed.png");
}


CommonTitleBar QToolButton#btnHelp {
	border-top: 2px solid transparent;
	border-image: url("Skins/Default/CamTools/Parts_Help_Btn_Normal.png");
}
CommonTitleBar QToolButton#btnHelp:hover {
	border-top: 2px solid transparent;
	border-image: url("Skins/Default/CamTools/Parts_Help_Btn_Hover.png");
}
CommonTitleBar QToolButton#btnHelp:pressed {
	border-top: 2px solid transparent;
	border-image: url("Skins/Default/CamTools/Parts_Help_Btn_Pressed.png");
}

QLabel#lbToolLogo {
	padding: 0 6;
	min-width: 32px;
	image: url("Skins/Default/CamTools/Parts_Icon_CamTools_Logo.png");
}

QSpcView QPushButton {
	min-width: 15px;
}

QSpcView QLabel#imageDisplay_new{
	background-color: rgb(225, 225, 225);
	border: 2px solid #828790;
}
QSpcView QWidget#widget{
	background-color: rgb(226, 226, 226);
}

QLabel#cueLab,
QLabel#cueLab1,
QLabel#lbOfflineTip {
	font-size: 12px;
	font-weight:300;
	color:rgb(236,137,9);
}